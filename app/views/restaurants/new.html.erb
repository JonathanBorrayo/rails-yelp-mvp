<div class="container my-4">
  <h1 class="mb-4">New restaurant</h1>

  <%= simple_form_for @restaurant do |f| %>
    <%= f.input :name %>
    <%= f.input :address %>
    <%= f.input :phone_number %>
    <%= f.input :category, collection: Restaurant::CATEGORIES, include_blank: false %>
    <%= f.button :submit, class: "btn btn-primary" %>
  <% end %>

  <%= link_to "Back to restaurants", restaurants_path, class: "mt-3 d-inline-block" %>
</div>
